#!/usr/bin/env ruby
# frozen_string_literal: true

# Usage: tools/boot_smoke out/<platform>
#
# Boot-smoke (conventions.md): dlopen the packaged libtebako-crypto FROM
# THE IMAGE (extracted with the pinned tfs CLI — extraction is THE smoke
# path for a library payload: no FUSE semantics are needed to prove the
# bytes), with an EMPTY environment, and run
# the full ABI exercise (tools/boot_smoke_harness.c): ABI version, key
# generation, export, sign/verify with the Trusted/Untrusted/Invalid
# classification, armor round-trip, and the ENC envelope round-trip
# including the wrong-key EKEY class. Then an otool/readelf sweep proves
# the closure rule: nothing but the OS family.

require_relative "lib/tpkg"
require "tmpdir"

out_dir = ARGV[0] or Tpkg.die("usage: tools/boot_smoke out/<platform>")
recipe = Tpkg.recipe(File.join(Tpkg::ROOT, "Tebakofile"))
name = recipe["name"]
img = Dir[File.join(out_dir, "*.tfs")].first or Tpkg.die("no .tfs image in #{out_dir}")
platform = File.basename(img).sub(/\A#{name}-[\d.]+-/, "").sub(/\.tfs\z/, "")
macos = platform.end_with?("-macos")
lib_leaf = macos ? "libtebako-crypto.1.dylib" : "libtebako-crypto.so.1"
tools = Tpkg.ensure_tfs_cli(recipe, platform: platform)
# prefer the image tool staged next to the image (same run's build/download)
staged = File.join(out_dir, "image-tools", "tfs")
tools["tfs"] = staged if File.executable?(staged)

extracted = Dir.mktmpdir("tpkg-extract")
Tpkg.log("extract-mode smoke (tfs extract)")
Tpkg.sh(tools["tfs"], "extract", "-d", extracted, img)
point = extracted

begin
  lib = File.join(point, "lib", lib_leaf)
  Tpkg.die("#{lib} missing in image") unless File.exist?(lib)
  Tpkg.die("ABI header missing in image") unless File.exist?(File.join(point, "include", "tebako_crypto_v1.h"))

  # the harness compiles against the shipped header and dlopens the lib
  # from the image — the same shape the tebako-side client will use.
  harness = File.join(Dir.mktmpdir("tpkg-harness"), "boot_smoke_harness")
  Tpkg.sh(ENV.fetch("CC", "cc"), "-O2", "-Wall",
          "-I#{File.join(point, 'include')}",
          File.join(Tpkg::ROOT, "tools", "boot_smoke_harness.c"),
          "-o", harness, *(macos ? [] : ["-ldl"]))

  home = Dir.mktmpdir("tpkg-home")
  # env -i: empty environment (+ HOME only) — the payload must stand alone.
  out_txt, ok = Tpkg.capture("env", "-i", "HOME=#{home}", harness, lib)
  Tpkg.die("boot-smoke harness failed:\n#{out_txt}") unless ok
  Tpkg.log(out_txt.strip)

  # closure sweep on the artifact as it ships inside the image: nothing
  # but the OS family (no botan/json-c/bz2/rnp/zlib dylibs, ever).
  if macos
    refs = Tpkg.otool_refs(lib)
    bad = []
    refs.each_with_index do |ref, i|
      next if i.zero? # install name
      bad << ref unless ref.match?(Tpkg::MACOS_SYSTEM_REF)
    end
    Tpkg.die("otool sweep failed (non-system refs):\n  #{bad.join("\n  ")}") unless bad.empty?
    Tpkg.log("otool sweep: #{refs.size - 1} refs, all /usr/lib|/System (install name #{refs[0]})")
  else
    out_txt, ok = Tpkg.capture("readelf", "-d", lib)
    Tpkg.die("readelf failed:\n#{out_txt}") unless ok
    needed = out_txt.scan(/\(NEEDED\).*?\[([^\]]+)\]/).flatten
    allowed = %w[libc.so.6 libm.so.6 ld-linux-x86-64.so.2 libdl.so.2 libpthread.so.0 librt.so.1]
    bad = needed - allowed
    Tpkg.die("readelf sweep failed (NEEDED beyond libc/libm): #{bad.join(', ')}") unless bad.empty?
    Tpkg.log("readelf sweep: NEEDED = #{needed.join(', ')}")
  end
ensure
  FileUtils.rm_rf(extracted) if extracted
end
Tpkg.log("BOOT_SMOKE_OK #{File.basename(img)}")
